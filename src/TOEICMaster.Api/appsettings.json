{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [] },
  "Jwt": {
    "Issuer": "TOEICMaster.Api",
    "Audience": "TOEICMaster.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 1,
    "RememberMeRefreshTokenDays": 30
  },
  "Google": {},
  "EmailVerification": {
    "LifetimeMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 10
  },
  "Gemini": {
    "Enabled": false,
    "Model": "gemini-2.5-flash-lite",
    "RequestTimeoutSeconds": 45,
    "RubricVersion": "toeic-writing-v1"
  }
}
